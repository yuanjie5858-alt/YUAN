.game-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.hero,
.stats,
.progress-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow {
  color: #d45f88;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 8rpx;
  color: #61315f;
  font-size: 52rpx;
  font-weight: 900;
}

.restart,
.play-again {
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7aa8, #ffbf5e);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 168, 0.35);
}

.panel,
.progress-card,
.board,
.dialog {
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 18rpx 48rpx rgba(174, 104, 126, 0.18);
}

.stats {
  margin-top: 28rpx;
  padding: 24rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.label {
  display: block;
  color: #a07596;
  font-size: 24rpx;
}

.value {
  display: block;
  margin-top: 8rpx;
  color: #603660;
  font-size: 42rpx;
  font-weight: 900;
}

.danger {
  color: #ef4d6d;
}

.progress-card {
  margin-top: 22rpx;
  padding: 22rpx;
}

.progress-info {
  color: #8a6281;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-track {
  height: 20rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ffe0eb;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff78a8, #ffd35d);
  transition: width 0.25s ease;
}

.board {
  display: grid;
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 14rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,241,247,0.9));
}

.tile {
  aspect-ratio: 1;
  padding: 4rpx;
  transition: transform 0.14s ease, opacity 0.16s ease;
}

.tile-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  font-size: 42rpx;
  background: #fff;
  box-shadow: inset 0 -8rpx 0 rgba(0, 0, 0, 0.06), 0 6rpx 12rpx rgba(141, 87, 111, 0.14);
}

.selected {
  transform: scale(1.08) rotate(-4deg);
}

.selected .tile-inner {
  outline: 6rpx solid #ffcf57;
}

.matched {
  opacity: 0.25;
  transform: scale(0.72);
}

.type-0 { background: #ffe3ec; }
.type-1 { background: #fff0ca; }
.type-2 { background: #eadfff; }
.type-3 { background: #e0f8d2; }
.type-4 { background: #fff6b9; }

.tips {
  margin-top: 28rpx;
  padding: 24rpx;
  color: #805f7c;
  font-size: 26rpx;
  line-height: 1.7;
}

.tip-title {
  margin-bottom: 8rpx;
  color: #61315f;
  font-size: 30rpx;
  font-weight: 900;
}

.overlay {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(71, 39, 70, 0.42);
  backdrop-filter: blur(8rpx);
}

.dialog {
  width: 560rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.dialog-icon {
  font-size: 88rpx;
}

.dialog-title {
  margin-top: 12rpx;
  color: #603660;
  font-size: 42rpx;
  font-weight: 900;
}

.dialog-text {
  margin: 16rpx 0 28rpx;
  color: #8a6281;
  font-size: 28rpx;
}

.play-again {
  width: 280rpx;
}
